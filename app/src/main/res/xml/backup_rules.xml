<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      Файл DataStore (mahalla_preferences) содержит токены сессии и хэш PIN.
      В облачный бэкап он попадать не должен: ключ Keystore не переносится,
      а токены восстановились бы на чужом устройстве в открытом виде.
      Язык и тема — потеря невелика, их проще спросить заново.
    -->
    <exclude
        domain="file"
        path="datastore/" />
</full-backup-content>
