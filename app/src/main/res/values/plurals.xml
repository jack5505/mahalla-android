<?xml version="1.0" encoding="utf-8"?>
<!--
    Количественные строки (uz — язык по умолчанию). Всё, где число стоит рядом
    с существительным, живёт здесь: в русском «1 секунду / 2 секунды /
    5 секунд» — три разные формы, и обычная строка их не покрывает.

    В узбекском существительное после числительного не изменяется, поэтому
    формы one и other совпадают; объявлены обе — Android выбирает по правилам
    CLDR, а не по языку файла.
-->
<resources>

    <!-- Онбординг: таймер повторной отправки кода (эпик 3.3). -->
    <plurals name="onboarding_otp_resend_timer">
        <item quantity="one">Qayta yuborish %1$d sekunddan keyin</item>
        <item quantity="other">Qayta yuborish %1$d sekunddan keyin</item>
    </plurals>

    <!--
        UI-кит: сколько цифр кода уже введено (TalkBack). Форма выбирается по
        длине кода — именно с ней согласуется существительное («из 6 цифр»),
        а не с числом уже введённых.
    -->
    <plurals name="otp_input_progress">
        <item quantity="one">%1$d / %2$d raqam kiritildi</item>
        <item quantity="other">%1$d / %2$d raqam kiritildi</item>
    </plurals>

    <!-- Еда: слот доставки не раньше чем через N минут (эпик 5, checkout). -->
    <plurals name="checkout_error_time_too_soon">
        <item quantity="one">Vaqt kamida %1$d daqiqadan keyin bo\'lsin</item>
        <item quantity="other">Vaqt kamida %1$d daqiqadan keyin bo\'lsin</item>
    </plurals>

    <!-- Еда: сколько ждать заказ. -->
    <plurals name="order_eta">
        <item quantity="one">Taxminan %1$d daqiqa</item>
        <item quantity="other">Taxminan %1$d daqiqa</item>
    </plurals>

    <!-- Центр уведомлений: подпись бейджа для TalkBack (issue #81). -->
    <plurals name="notifications_unread_count">
        <item quantity="one">%1$d ta o\'qilmagan</item>
        <item quantity="other">%1$d ta o\'qilmagan</item>
    </plurals>

    <!-- Форма отзыва: подпись звезды для TalkBack (issue #76). -->
    <plurals name="rating_star_description">
        <item quantity="one">%1$d yulduz</item>
        <item quantity="other">%1$d yulduz</item>
    </plurals>

    <!-- Анкеты (issue #84): границы длины полей. -->
    <plurals name="role_error_too_long">
        <item quantity="one">%1$d belgidan oshmasin</item>
        <item quantity="other">%1$d belgidan oshmasin</item>
    </plurals>

    <plurals name="role_error_too_short">
        <item quantity="one">Kamida %1$d belgi kiriting</item>
        <item quantity="other">Kamida %1$d belgi kiriting</item>
    </plurals>

</resources>
