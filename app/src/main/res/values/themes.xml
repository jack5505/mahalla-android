<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Базовая тема окна до старта Compose. Основная тема приложения — тёмная. -->
    <style name="Theme.Mahalla" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mahalla_background_dark</item>
        <item name="android:statusBarColor">@color/mahalla_background_dark</item>
        <item name="android:navigationBarColor">@color/mahalla_background_dark</item>
    </style>

    <!--
      Core SplashScreen API (эпик 1.6). Иконка пока временная (заглушка
      лаунчера) — заменить на брендовый логотип, когда появится ассет.
    -->
    <style name="Theme.Mahalla.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mahalla_background_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Mahalla</item>
    </style>
</resources>
